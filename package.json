{
  "name": "bitterclip-marketing",
  "type": "module",
  "private": true,
  "description": "BitterClip is a speaker-aware media workspace for turning long recordings into source-linked clips.",
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "artifact:bake": "node qa/iso4-artifact-bake.mjs",
    "artifact:encode": "node qa/iso4-artifact-encode.mjs",
    "artifact:packet": "node qa/iso4-artifact-packet.mjs",
    "artifact:promote": "node qa/iso4-artifact-promote.mjs",
    "qa:artifact-playback": "node qa/iso4-artifact-playback.mjs",
    "qa:artifact-promote": "node --test qa/iso4-artifact-promote.test.mjs",
    "qa:lighthouse-static": "node qa/lighthouse-static.mjs",
    "qa:smoke": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@nuxt/content": "^3.14.0",
    "better-sqlite3": "^12.11.1",
    "nuxt": "^4.4.4",
    "three": "^0.185.1",
    "vue": "^3.5.34",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/three": "^0.185.4",
    "tailwindcss": "^4.2.2"
  },
  "overrides": {
    "devalue": "5.8.1"
  }
}
