  "live_workspace": {
    "title": "Get BitterClip workspace link",
    "description": "Read-only. Returns the exact authorized BitterClip workspace link for a recording, Episode, Clip, Project, or publish package. This prepares a link; it does not open a browser or verify visible navigation.",
    "opened_description": "Always false in Live Workspace mode; this tool prepares a link and does not prove browser navigation.",
    "workspace_binding_schema": {
      "type": "object",
