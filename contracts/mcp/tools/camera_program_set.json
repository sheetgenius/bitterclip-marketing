              ]
            },
            {
              "required": [
                "revert_receipt_id"
              ]
            }
          ]
        }
      },
      {
        "required": [
          "revert_receipt_id"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "episode_range"
              ]
            },
            {
              "required": [
                "camera"
              ]
            },
            {
              "required": [
                "picture_time"
              ]
            },
            {
