    "properties": {
      "project_id": {
        "type": "string",
        "description": "Project public ID."
      }
    },
    "required": [
      "project_id"
    ],
    "additionalProperties": false
  },
  "errors": [
    "project_not_found",
    "invalid_input"
  ],
  "examples": [],
  "output_schema": {
    "type": "object",
    "properties": {
      "schema": {
        "type": "string"
      },
      "project_id": {
        "type": "string"
      },
      "project_title": {
        "type": "string"
      },
      "brand_identity": {
        "type": "object"
      },
      "options": {
        "type": "object"
      },
      "music_beds": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "account_scenes": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "blockers": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    },
    "required": [],
    "additionalProperties": false
  }
}
